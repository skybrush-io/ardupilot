#!/usr/bin/env python3

def build(bld):
    vehicle = bld.path.name

    bld.stlib(
        name='libskybrush',
        source=(
            bld.path.parent.ant_glob(
                'modules/libskybrush/src/**/*.c',
                excl='modules/libskybrush/src/tools'
            ) +
            bld.path.parent.ant_glob(
                'modules/libskybrush/src/**/*.cpp',
                excl='modules/libskybrush/src/tools'
            )
        ),
        target='skybrush',
        defines=['NDEBUG'],
        output_dir=bld.bldnode.find_or_declare('modules/libskybrush').abspath()
    )

    bld.ap_stlib(
        name=vehicle + '_libs',
        ap_vehicle=vehicle,
        ap_libraries=bld.ap_common_vehicle_libraries() + [
            'APM_Control',
            'AP_Mount',
            'AP_Navigation',
            'AR_WPNav',
            'AP_AdvancedFailsafe',
            'AP_WheelEncoder',
            'AP_SmartRTL',
            'AC_AttitudeControl',
            'AP_LTM_Telem',
            'AP_Devo_Telem',
            'AP_WindVane',
            'AR_Motors',
            'AP_Torqeedo',
            'AC_PrecLand',
            'AP_IRLock',
            'AC_BubbleFence',
            'AC_DroneShowManager',
            'AC_HardFence',
        ],
        use='libskybrush'
    )

    bld.ap_program(
        program_name='ardurover',
        program_groups=['bin', 'rover'],
        use=vehicle + '_libs',
    )
